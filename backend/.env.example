# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cinevault
DB_PORT=3306
# Optional: paste the hosted MySQL provider's CA certificate PEM here.
# Keep the certificate in one line with literal \n between lines, or set DB_SSL_CA in the host dashboard.
# DB_SSL_CA=

# JWT Authentication Configuration
JWT_SECRET=cinevault_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
